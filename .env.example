# ============================================================================
# ai-harness configuration. Copy to `.env` and fill in what you need.
# Everything works out of the box with ZERO keys via the offline `mock`
# provider, so you can run, test, and explore without spending a cent.
# ============================================================================

# ---- Providers (optional; defaults to the offline 'mock' provider) ---------
DEFAULT_PROVIDER=mock            # mock | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Adaptive model router -------------------------------------------------
# How the router trades off when picking a model for each request.
ROUTER_POLICY=balanced           # cost | latency | quality | balanced

# ---- Guardrails ------------------------------------------------------------
ENABLE_PII_REDACTION=true
BLOCK_ON_INJECTION=true

# ---- Agent loop ------------------------------------------------------------
MAX_AGENT_STEPS=6

# ---- Observability: Langfuse (optional; traces are sent only when set) -----
# Get free keys at https://cloud.langfuse.com (or self-host via docker-compose).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
